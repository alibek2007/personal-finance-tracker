# Copy to .env.production and fill in. Never commit the real file.

POSTGRES_USER=ledger
# A long random password.   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
POSTGRES_DB=pfm

# At least 32 random characters; signs the session cookie. Rotating it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# The exact public origin people type into the browser (scheme + host, no trailing slash).
# Used for the CORS allowlist and the CSRF origin check, so it must match.
WEB_ORIGINS=https://ledger.example.com

WEB_PORT=8080
LOG_LEVEL=info
