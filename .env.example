# --- API ---
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Comma-separated list of allowed browser origins (CORS + CSRF origin check)
WEB_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://pfm:pfm_dev_password@localhost:54329/pfm?schema=public
# Test database (integration tests create/reset schemas here)
TEST_DATABASE_URL=postgresql://pfm:pfm_dev_password@localhost:54329/pfm_test?schema=public
# Cookie signing secret: at least 32 random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-change-me-change-me-change-me
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
LOG_LEVEL=info

# --- Web ---
VITE_API_URL=http://localhost:4000
AUTH_RATE_LIMIT_MAX=10
# Requests per minute per client IP across the whole API
RATE_LIMIT_MAX=300
